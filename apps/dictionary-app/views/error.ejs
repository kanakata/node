<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .error{
        font-size: 30px;
      }
      span{
        color: red;
        font-family: italic;
      }
      h1{
        padding: 10px;
        background: rgb(230, 230, 235);
        border-radius: 4px;
      }
    </style>
  </head>
  <body>
    <h1 class="error"><span>Oops!!! </span><%= error %></h1>
  </body>
</html>
