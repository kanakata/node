<% const users = ["jane", "joe"] %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      nav {
        width: 100%;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px;
        & h1 {
          font-size: 20px;
        }
      }
      main {
        width: 100%;
        height: 100vh;
      }
      footer {
        width: 100%;
      }
    </style>
  </head>
  <body>
    <header>
      <nav>
        <h1>Clearpass</h1>
        <ul>
          <li><a href="/login">Login</a></li>
        </ul>
      </nav>
    </header>
    <main>
      <%for(let i = 0 ; i < users.length;i++){ %>
      <h1>hello <%= users[i] %></h1>
      <%}%>
    </main>
    <footer>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/privacy">privacy policy</a></li>
        <p>&copy; Clearpass 2026</p>
      </ul>
    </footer>
  </body>
</html>
